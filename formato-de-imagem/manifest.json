{
  "manifest_version": 3,
  "name": "Formato de imagem",
  "version": "1.0.0",
  "description": "Baixe qualquer imagem no formato que quiser (PNG, JPG, WEBP ou original), inclusive em sites que bloqueiam o botão direito.",
  "minimum_chrome_version": "110",
  "permissions": ["contextMenus", "downloads", "activeTab", "scripting", "storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Formato de imagem",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
